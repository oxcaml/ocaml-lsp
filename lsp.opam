# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "LSP protocol implementation in OCaml"
maintainer: ["Jane Street developers"]
authors: ["ocaml-lsp contributors" "Jane Street Group, LLC"]
license: "ISC"
homepage: "https://github.com/oxcaml/ocaml-lsp"
bug-reports: "https://github.com/oxcaml/ocaml-lsp/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "5.4" & < "5.5"}
  "jsonrpc" {= version}
  "async"
  "base"
  "core"
  "dyn" {with-test}
  "file_path"
  "ppx_bin_prot"
  "ppx_compare"
  "ppx_expect" {with-test}
  "ppx_js_style"
  "ppx_let"
  "ppx_sexp_conv"
  "ppx_string"
  "ppx_yojson_conv"
  "uutf"
  "yojson"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/oxcaml/ocaml-lsp.git"
x-maintenance-intent: ["(latest)"]

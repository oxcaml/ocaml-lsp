opam-version: "2.0"
synopsis: "LSP protocol implementation in OCaml"
depends: [
  "dune" {>= "3.11"}
  "jsonrpc" {= version}
  "async"
  "base"
  "core"
  "file_path"
  "ppx_bin_prot"
  "ppx_compare"
  "ppx_js_style"
  "ppx_let"
  "ppx_sexp_conv"
  "ppx_string"
  "ppx_yojson_conv"
  "uutf"
  "yojson"
]
build: [
  ["dune" "build" "-p" name "@install"]
]

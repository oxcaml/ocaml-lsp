opam-version: "2.0"
synopsis: "OCaml Language Server Protocol implementation for oxcaml"
depends: [
  "dune" {>= "3.11"}
  "ocaml" {>= "5.4" & < "5.5"}
  "async"
  "base"
  "cmarkit"
  "cppo" {build}
  "core"
  "core_unix"
  "csexp"
  "expect_test_helpers_async" {with-test}
  "expect_test_helpers_core" {with-test}
  "file_path"
  "lrgrep"
  "merlin-lib"
  "ocamlc-loc"
  "odoc-parser" {= "2.0.0"}
  "ppx_bin_prot"
  "ppx_compare"
  "ppx_enumerate"
  "ppx_expect" {with-test}
  "ppx_here"
  "ppx_jane" {with-test}
  "ppx_js_style"
  "ppx_let"
  "ppx_log"
  "ppx_sexp_conv"
  "ppx_sexp_message"
  "ppx_sexp_value"
  "ppx_string"
  "ppx_yojson_conv"
  "re"
  "re2"
  "spawn"
  "uutf"
  "yojson"
  "menhir" {with-test & = "20231231"}
]
build: [
  ["dune" "build" "-p" "ocaml-lsp-server,jsonrpc,lsp" "@install"]
]
run-test: [
  ["dune" "runtest" "-p" "ocaml-lsp-server,jsonrpc,lsp"]
]
